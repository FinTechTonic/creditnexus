# Fee payer (hex with 0x). Required for /settle.
APTOS_PRIVATE_KEY=0x...

PORT=4022

# creditnexus = only allow payTo in PAY_TO_ALLOWLIST; community = any payTo
FACILITATOR_MODE=community
PAY_TO_ALLOWLIST=

APTOS_NETWORK=testnet

# Optional; default Aptos testnet fullnode
APTOS_FULLNODE_URL=

# Optional; mount routes under /facilitator (base/facilitator/verify, base/facilitator/settle)
# USE_FACILITATOR_PREFIX=false

# EVM (EIP-3009) for open_bank_account: relayer pays gas for receiveWithAuthorization
EVM_RELAYER_PRIVATE_KEY=0x...
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_RPC=https://mainnet.base.org

# Optional: wallet balance check before verify (Aptos + EVM); return insufficient_funds + onramp_url
# ENABLE_WALLET_CHECK=false
# ONRAMP_URL=https://faucet.circle.com
