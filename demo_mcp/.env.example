# CreditNexus demo MCP launcher (demo_mcp/scripts/launch-demo-mcp.mjs)
# Copy to demo_mcp/.env or set in project root .env

# -----------------------------------------------------------------------------
# Administrator credentials
# -----------------------------------------------------------------------------
# Used to log in and create API key; saved to demo_mcp/server/.env as CREDITNEXUS_SERVICE_KEY
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# CreditNexus backend
# -----------------------------------------------------------------------------
# Backend URL for launcher (login, generate API key). Default below.
# CREDITNEXUS_URL=http://localhost:8000
