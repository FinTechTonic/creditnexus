# CreditNexus MCP Server – copy to server/.env
# See demo_mcp/README.md § Configuration for full reference.

# -----------------------------------------------------------------------------
# CreditNexus Backend
# -----------------------------------------------------------------------------
# Backend URL (Plaid link-token, exchange; API key auth)
CREDITNEXUS_API_URL=http://localhost:8000
# API key from CreditNexus admin: POST /api/admin/generate-api-key (admin only)
# Launcher writes this to server/.env when you run npm run demo-mcp:launch
CREDITNEXUS_SERVICE_KEY=

# -----------------------------------------------------------------------------
# x402 Facilitator
# -----------------------------------------------------------------------------
# Aptos: run_prediction, run_backtest, score tools. Use public for full demo.
X402_FACILITATOR_URL=https://x402.org/facilitator
# EVM: open_bank_account. Defaults to X402_FACILITATOR_URL; set when using local Aptos facilitator
# X402_EVM_FACILITATOR_URL=https://x402-navy.vercel.app/facilitator

# -----------------------------------------------------------------------------
# Allowlists
# -----------------------------------------------------------------------------
# Comma-separated agent addresses (EVM and/or Aptos). When ONBOARDING_ALLOWLIST_FILE is set,
# server re-reads that file on each request so whitelist updates without restart.
AGENT_ALLOWLIST=
PAY_TO_ALLOWLIST=
# Path to allowlist JSON written by onboarding (e.g. demo_mcp/onboarding/allowlist.json)
# When set, agents and pay_to are merged from this file on every request
# ONBOARDING_ALLOWLIST_FILE=

# -----------------------------------------------------------------------------
# Aptos (Testnet) – prediction, backtest, score
# -----------------------------------------------------------------------------
APTOS_NETWORK=aptos:2
APTOS_USDC_ASSET=0x69091fbab5f7d635ee7ac5098cf0c1efbe31d68fec0f2cd565e8d168daf52832
# Aptos payTo for x402; if empty, first pay_to from allowlist (e.g. from flow.html) is used
APTOS_PAYTO_ADDRESS=

# -----------------------------------------------------------------------------
# EVM (Base Sepolia) – open_bank_account
# -----------------------------------------------------------------------------
BASE_SEPOLIA_NETWORK=eip155:84532
BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_PAYTO=

# -----------------------------------------------------------------------------
# Pricing (USD)
# -----------------------------------------------------------------------------
MCP_PRICE_PREDICTION_USD=0.06
MCP_PRICE_BACKTEST_USD=0.06
MCP_PRICE_BANKING_USD=3.65
MCP_PRICE_SCORE_USD=0.01

# -----------------------------------------------------------------------------
# Server & x402
# -----------------------------------------------------------------------------
PORT=4023
MAX_TIMEOUT_SECONDS=60
# Shown in 402 response for user funding
ONRAMP_URL=https://faucet.circle.com
