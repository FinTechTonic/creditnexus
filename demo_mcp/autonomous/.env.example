# MCP server (x402-enabled)
MCP_SERVER_URL=http://localhost:4023

# x402 facilitator (verify/settle)
X402_FACILITATOR_URL=https://x402-navy.vercel.app/facilitator

# Hugging Face inference (OpenAI-compatible)
LLM_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_API_KEY=
# or HF_TOKEN=

LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Wallets
APTOS_WALLET_PATH=~/.aptos-agent-wallet.json
EVM_WALLET_PATH=~/.evm-wallet.json

# Base Sepolia (for open_bank_account)
BASE_SEPOLIA_RPC=https://sepolia.base.org
# BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Optional: MCP tool path
# MCP_TOOL_NAMES=run_prediction,run_backtest,open_bank_account
