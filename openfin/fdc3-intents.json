{
  "$schema": "https://fdc3.finos.org/schemas/2.0/app-directory/app.schema.json",
  "applications": [
    {
      "appId": "creditnexus",
      "name": "CreditNexus",
      "title": "CreditNexus - Credit, Trading & Prediction Markets",
      "description": "FINOS CDM– and FDC3 2.0–compliant platform: credit agreement extraction, Alpaca trading, stock prediction (Chronos), Polymarket-style SFPs, LangAlpha quantitative analysis, and ESG verification",
      "version": "1.0.0",
      "publisher": "CreditNexus",
      "categories": [
        "Analytics",
        "Credit",
        "Lending",
        "AI",
        "Document Processing",
        "Trading",
        "Prediction Markets"
      ],
      "icons": [
        {
          "src": "http://localhost:8000/favicon.ico",
          "size": "256x256",
          "type": "image/x-icon"
        }
      ],
      "screenshots": [],
      "type": "web",
      "details": {
        "url": "http://localhost:8000"
      },
      "interop": {
        "intents": {
          "listensFor": {
            "ViewLoanAgreement": {
              "displayName": "View Loan Agreement",
              "contexts": [
                "finos.creditnexus.agreement",
                "fdc3.instrument"
              ],
              "resultType": "finos.creditnexus.agreement"
            },
            "ApproveLoanAgreement": {
              "displayName": "Approve Loan Agreement",
              "contexts": [
                "finos.creditnexus.agreement"
              ],
              "resultType": "finos.creditnexus.approvalResult"
            },
            "ViewESGAnalytics": {
              "displayName": "View ESG Analytics",
              "contexts": [
                "finos.creditnexus.portfolio",
                "finos.creditnexus.agreement"
              ],
              "resultType": "finos.creditnexus.esgData"
            },
            "ExtractCreditAgreement": {
              "displayName": "Extract Credit Agreement",
              "contexts": [
                "finos.creditnexus.document"
              ],
              "resultType": "finos.creditnexus.agreement"
            },
            "ViewPortfolio": {
              "displayName": "View Portfolio",
              "contexts": [
                "fdc3.portfolio",
                "finos.creditnexus.portfolio"
              ],
              "resultType": "finos.creditnexus.portfolio"
            },
            "GenerateLMATemplate": {
              "displayName": "Generate LMA Template",
              "contexts": [
                "finos.creditnexus.agreement",
                "finos.creditnexus.loan"
              ],
              "resultType": "finos.creditnexus.generatedDocument"
            },
            "ShareWorkflowLink": {
              "displayName": "Share Workflow Link",
              "contexts": [
                "finos.creditnexus.workflow"
              ],
              "resultType": "finos.creditnexus.workflow"
            },
            "ProcessWorkflowLink": {
              "displayName": "Process Workflow Link",
              "contexts": [
                "finos.creditnexus.workflow"
              ],
              "resultType": "finos.creditnexus.workflow"
            },
            "ViewInstrument": {
              "displayName": "View Instrument",
              "contexts": [
                "fdc3.instrument",
                "finos.creditnexus.instrument"
              ],
              "resultType": "fdc3.instrument"
            },
            "ViewStockPrediction": {
              "displayName": "View Stock Prediction",
              "contexts": [
                "finos.creditnexus.stockPrediction",
                "fdc3.instrument"
              ],
              "resultType": "finos.creditnexus.stockPrediction"
            },
            "ViewPredictionMarket": {
              "displayName": "View Prediction Market",
              "contexts": [
                "finos.creditnexus.predictionMarket"
              ],
              "resultType": "finos.creditnexus.predictionMarket"
            },
            "ViewAgentResult": {
              "displayName": "View Agent Result",
              "contexts": [
                "finos.creditnexus.agentResult"
              ],
              "resultType": "finos.creditnexus.agentResult"
            }
          },
          "raises": {
            "ViewChart": {
              "contexts": [
                "fdc3.timeRange"
              ]
            },
            "ViewInstrument": {
              "contexts": [
                "fdc3.instrument",
                "finos.creditnexus.instrument"
              ]
            },
            "ViewStockPrediction": {
              "contexts": [
                "finos.creditnexus.stockPrediction",
                "fdc3.instrument"
              ]
            },
            "ViewPredictionMarket": {
              "contexts": [
                "finos.creditnexus.predictionMarket"
              ]
            },
            "ViewAgentResult": {
              "contexts": [
                "finos.creditnexus.agentResult"
              ]
            }
          }
        },
        "userChannels": {
          "broadcasts": [
            "finos.creditnexus.agreement",
            "finos.creditnexus.approvalResult",
            "finos.creditnexus.portfolio",
            "finos.creditnexus.workflow",
            "finos.creditnexus.generatedDocument",
            "finos.creditnexus.loan",
            "finos.creditnexus.stockPrediction",
            "finos.creditnexus.predictionMarket",
            "finos.creditnexus.agentResult",
            "finos.creditnexus.dealSignature",
            "finos.creditnexus.dealDocumentation",
            "finos.creditnexus.dealCompliance",
            "fdc3.instrument",
            "finos.creditnexus.instrument"
          ],
          "listensFor": [
            "fdc3.instrument",
            "fdc3.portfolio",
            "finos.creditnexus.document",
            "finos.creditnexus.stockPrediction",
            "finos.creditnexus.predictionMarket",
            "finos.creditnexus.agentResult",
            "finos.creditnexus.instrument"
          ]
        },
        "appChannels": [
          {
            "name": "creditnexus.workflow",
            "description": "Channel for workflow state updates and approvals",
            "broadcasts": [
              "finos.creditnexus.agreement",
              "finos.creditnexus.approvalResult",
              "finos.creditnexus.workflow",
              "finos.creditnexus.dealSignature",
              "finos.creditnexus.dealDocumentation",
              "finos.creditnexus.dealCompliance"
            ],
            "listensFor": [
              "finos.creditnexus.approvalResult",
              "finos.creditnexus.workflow",
              "finos.creditnexus.dealSignature",
              "finos.creditnexus.dealDocumentation",
              "finos.creditnexus.dealCompliance"
            ]
          },
          {
            "name": "creditnexus.extraction",
            "description": "Channel for document extraction events",
            "broadcasts": [
              "finos.creditnexus.agreement"
            ],
            "listensFor": [
              "finos.creditnexus.document"
            ]
          },
          {
            "name": "creditnexus.portfolio",
            "description": "Channel for portfolio analytics and updates",
            "broadcasts": [
              "finos.creditnexus.portfolio",
              "finos.creditnexus.esgData"
            ],
            "listensFor": [
              "finos.creditnexus.portfolio"
            ]
          },
          {
            "name": "creditnexus.trading",
            "description": "Channel for instrument, stock prediction, and order context (Alpaca, Chronos)",
            "broadcasts": [
              "fdc3.instrument",
              "finos.creditnexus.instrument",
              "finos.creditnexus.stockPrediction"
            ],
            "listensFor": [
              "fdc3.instrument",
              "finos.creditnexus.instrument",
              "finos.creditnexus.stockPrediction"
            ]
          },
          {
            "name": "creditnexus.predictionMarket",
            "description": "Channel for Polymarket-style SFP and prediction market context",
            "broadcasts": [
              "finos.creditnexus.predictionMarket"
            ],
            "listensFor": [
              "finos.creditnexus.predictionMarket"
            ]
          }
        ]
      },
      "hostManifests": {
        "OpenFin": {
          "type": "manifest",
          "details": "http://localhost:8000/openfin/app.json"
        }
      },
      "localizedVersions": {},
      "customConfig": {
        "contextTypes": {
          "finos.creditnexus.agreement": {
            "description": "Credit agreement context containing agreement details",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "finos.creditnexus.agreement"
                },
                "id": {
                  "type": "object",
                  "properties": {
                    "agreementId": {
                      "type": "string",
                      "description": "Unique identifier for the credit agreement"
                    },
                    "version": {
                      "type": "integer",
                      "description": "Version number of the agreement"
                    }
                  },
                  "required": [
                    "agreementId"
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "Display name of the agreement"
                },
                "borrower": {
                  "type": "string",
                  "description": "Name of the borrowing party"
                },
                "agreementDate": {
                  "type": "string",
                  "format": "date",
                  "description": "Date of the credit agreement"
                },
                "totalCommitment": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "type": "number"
                    },
                    "currency": {
                      "type": "string"
                    }
                  }
                },
                "workflowStatus": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "under_review",
                    "approved",
                    "published"
                  ]
                },
                "facilities": {
                  "type": "array",
                  "description": "Loan facilities in the agreement"
                },
                "parties": {
                  "type": "array",
                  "description": "Parties to the agreement"
                }
              },
              "required": [
                "type",
                "id"
              ]
            }
          },
          "finos.creditnexus.document": {
            "description": "Document context for extraction",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "finos.creditnexus.document"
                },
                "id": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string"
                    }
                  }
                },
                "name": {
                  "type": "string"
                },
                "content": {
                  "type": "string",
                  "description": "Raw text content of the document"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "content"
              ]
            }
          },
          "finos.creditnexus.portfolio": {
            "description": "Portfolio context",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "finos.creditnexus.portfolio"
                },
                "id": {
                  "type": "object",
                  "properties": {
                    "portfolioId": {
                      "type": "string"
                    }
                  }
                },
                "name": {
                  "type": "string"
                },
                "agreementIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "totalCommitment": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "type": "number"
                    },
                    "currency": {
                      "type": "string"
                    }
                  }
                },
                "agreementCount": {
                  "type": "integer"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "finos.creditnexus.approvalResult": {
            "description": "Approval workflow result",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "finos.creditnexus.approvalResult"
                },
                "agreementId": {
                  "type": "string"
                },
                "approved": {
                  "type": "boolean"
                },
                "approver": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "comments": {
                  "type": "string"
                },
                "newStatus": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "under_review",
                    "approved",
                    "published",
                    "rejected"
                  ]
                }
              },
              "required": [
                "type",
                "agreementId",
                "approved"
              ]
            }
          },
          "finos.creditnexus.esgData": {
            "description": "ESG analytics data",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "finos.creditnexus.esgData"
                },
                "agreementId": {
                  "type": "string"
                },
                "environmentalScore": {
                  "type": "number"
                },
                "socialScore": {
                  "type": "number"
                },
                "governanceScore": {
                  "type": "number"
                },
                "overallScore": {
                  "type": "number"
                },
                "greenLoanIndicators": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sustainabilityLinkedTerms": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "finos.creditnexus.loan": {
            "description": "Loan/credit agreement data (deal, facilities, parties); CDM-aligned",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.loan" },
                "id": { "type": "object", "properties": { "LIN": { "type": "string" }, "DealID": { "type": "string" } } },
                "loan": { "type": "object" }
              },
              "required": ["type"]
            }
          },
          "finos.creditnexus.workflow": {
            "description": "Workflow link (verification, notarization, document_review)",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.workflow" },
                "id": { "type": "object", "properties": { "workflowId": { "type": "string" } }, "required": ["workflowId"] },
                "workflowType": { "type": "string" },
                "linkPayload": { "type": "string" },
                "metadata": { "type": "object" }
              },
              "required": ["type", "workflowType", "linkPayload"]
            }
          },
          "finos.creditnexus.generatedDocument": {
            "description": "Generated document from LMA template and CDM data",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.generatedDocument" },
                "id": { "type": "object" },
                "template": { "type": "object" },
                "sourceCdmData": { "type": "object" },
                "generatedAt": { "type": "string" },
                "filePath": { "type": "string" },
                "status": { "type": "string" }
              },
              "required": ["type"]
            }
          },
          "finos.creditnexus.instrument": {
            "description": "Instrument/symbol for trading; extends fdc3.instrument for CDM and Alpaca",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.instrument" },
                "id": { "type": "object", "properties": { "ticker": { "type": "string" }, "symbol": { "type": "string" } } },
                "name": { "type": "string" },
                "exchange": { "type": "string" },
                "signal": { "type": "string", "enum": ["bullish", "bearish", "neutral"] }
              },
              "required": ["type"]
            }
          },
          "finos.creditnexus.stockPrediction": {
            "description": "Stock prediction result (Chronos/technical; symbol, timeframe, forecast, signal)",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.stockPrediction" },
                "symbol": { "type": "string" },
                "timeframe": { "type": "string", "enum": ["daily", "hourly", "15min"] },
                "strategy": { "type": "string" },
                "forecast": { "type": "array", "items": { "type": "number" } },
                "signal": { "type": "string", "enum": ["bullish", "bearish", "neutral"] },
                "prediction_id": { "type": "number" },
                "cached": { "type": "boolean" }
              },
              "required": ["type", "symbol"]
            }
          },
          "finos.creditnexus.predictionMarket": {
            "description": "Polymarket-style SFP / prediction market (market_id, question, outcomes, book)",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.predictionMarket" },
                "market_id": { "type": "string" },
                "question": { "type": "string" },
                "outcome_type": { "type": "string" },
                "deal_id": { "type": "number" },
                "sfp_id": { "type": "string" },
                "resolved_at": { "type": ["string", "null"] },
                "resolution_outcome": { "type": ["string", "null"] }
              },
              "required": ["type", "market_id"]
            }
          },
          "finos.creditnexus.agentResult": {
            "description": "LangAlpha/DeepResearch/PeopleHub analysis result; symbols and recommendations for cross-linking",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.agentResult" },
                "analysis_id": { "type": "string" },
                "agent_type": { "type": "string", "enum": ["langalpha", "deep_research", "peoplehub"] },
                "query": { "type": "string" },
                "summary": { "type": "string" },
                "symbols": { "type": "array", "items": { "type": "string" } },
                "recommendations": { "type": "array", "items": { "type": "string" } },
                "deal_id": { "type": ["number", "null"] }
              },
              "required": ["type", "analysis_id", "agent_type"]
            }
          },
          "finos.cdm.landUse": {
            "description": "CDM-aligned land use from satellite verification",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.cdm.landUse" },
                "id": { "type": "object", "properties": { "internalID": { "type": "string" } } },
                "classification": { "type": "string" },
                "complianceStatus": { "type": "string", "enum": ["COMPLIANT", "WARNING", "BREACH"] },
                "lastInferenceConfidence": { "type": "number" },
                "cloudCover": { "type": "number" }
              },
              "required": ["type"]
            }
          },
          "finos.cdm.greenFinanceAssessment": {
            "description": "CDM-aligned green finance assessment (location, AQI, sustainability, SDG)",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.cdm.greenFinanceAssessment" },
                "id": { "type": "object", "properties": { "transactionId": { "type": "string" } } },
                "location": { "type": "object" },
                "environmentalMetrics": { "type": "object" },
                "sustainabilityScore": { "type": "number" },
                "sdgAlignment": { "type": "object" },
                "assessedAt": { "type": "string" }
              },
              "required": ["type"]
            }
          },
          "finos.creditnexus.dealSignature": {
            "description": "Deal signature tracking context (status, progress, required/completed signatures)",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.dealSignature" },
                "id": { "type": "object", "properties": { "dealId": { "type": "string" } }, "required": ["dealId"] },
                "signatureStatus": { "type": "string" },
                "requiredSignatures": { "type": "number" },
                "completedSignatures": { "type": "number" },
                "signatureProgress": { "type": "number" }
              },
              "required": ["type", "id"]
            }
          },
          "finos.creditnexus.dealDocumentation": {
            "description": "Deal documentation tracking context (status, progress, required/completed documents)",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.dealDocumentation" },
                "id": { "type": "object", "properties": { "dealId": { "type": "string" } }, "required": ["dealId"] },
                "documentationStatus": { "type": "string" },
                "requiredDocuments": { "type": "number" },
                "completedDocuments": { "type": "number" },
                "documentationProgress": { "type": "number" }
              },
              "required": ["type", "id"]
            }
          },
          "finos.creditnexus.dealCompliance": {
            "description": "Deal compliance summary context (overall status, signature/documentation status)",
            "schema": {
              "type": "object",
              "properties": {
                "type": { "const": "finos.creditnexus.dealCompliance" },
                "id": { "type": "object", "properties": { "dealId": { "type": "string" } }, "required": ["dealId"] },
                "complianceStatus": { "type": "string" },
                "signatureStatus": { "type": "string" },
                "documentationStatus": { "type": "string" }
              },
              "required": ["type", "id"]
            }
          }
        }
      }
    }
  ]
}