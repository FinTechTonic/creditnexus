# Fee payer (hex with 0x). Required for /settle.
APTOS_PRIVATE_KEY=0x...

PORT=4022

# creditnexus = only allow payTo in PAY_TO_ALLOWLIST; community = any payTo
FACILITATOR_MODE=community
PAY_TO_ALLOWLIST=

APTOS_NETWORK=testnet

# Optional; default Aptos testnet fullnode
APTOS_FULLNODE_URL=

# Optional; mount routes under /facilitator (base/facilitator/verify, base/facilitator/settle)
# USE_FACILITATOR_PREFIX=false
